    "Cuts change the timeline, so the video is re-encoded with the same codec and bitrate as the source." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘라내면 타임라인이 바뀌므로 비디오를 원본과 같은 코덱과 비트레이트로 재인코딩합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪切会改变时间线，因此视频会以与源文件相同的编码格式和码率重新编码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪切會改變時間列，因此影片會以與來源相同的編碼格式和位元速率重新編碼。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cortes cambian la línea de tiempo, así que el vídeo se vuelve a codificar con el mismo códec y la misma tasa de bits que el archivo de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les coupes modifient la timeline, la vidéo est donc réencodée avec le même codec et le même débit que la source."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnitte ändern die Zeitleiste, daher wird das Video mit demselben Codec und derselben Bitrate wie die Quelle neu codiert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tagli cambiano la timeline, quindi il video viene ricodificato con lo stesso codec e lo stesso bitrate del file di origine."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os cortes mudam a linha do tempo, então o vídeo é recodificado com o mesmo codec e a mesma taxa de bits do arquivo de origem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knippen verandert de tijdlijn, dus de video wordt opnieuw gecodeerd met dezelfde codec en bitsnelheid als de bron."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cięcia zmieniają oś czasu, więc wideo jest ponownie kodowane tym samym kodekiem i z tą samą przepływnością co źródło."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вырезы меняют временную шкалу, поэтому видео перекодируется тем же кодеком и с тем же битрейтом, что и исходное."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesimler zaman çizelgesini değiştirdiği için video, kaynakla aynı kodek ve bit hızıyla yeniden kodlanır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットによってタイムラインが変わるため、ビデオは元と同じコーデックとビットレートで再エンコードされます。"
          }
        }
      }
    },
    "Cuts the video at the nearest keyframes without re-encoding it. The picture is untouched but the cut may land a few frames off." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재인코딩 없이 가장 가까운 키프레임에서 비디오를 자릅니다. 화면은 그대로지만 자르는 위치가 몇 프레임 어긋날 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最近的关键帧处剪切视频，无需重新编码。画面完全不变，但剪切位置可能偏差几帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最近的關鍵影格剪切影片，不重新編碼。畫面完全不變，但剪切位置可能偏移幾個影格。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta el vídeo en los fotogramas clave más cercanos sin volver a codificarlo. La imagen no se toca, pero el corte puede desviarse unos fotogramas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe la vidéo aux images clés les plus proches sans la réencoder. L'image reste intacte, mais la coupe peut être décalée de quelques images."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneidet das Video ohne Neucodierung am nächsten Keyframe. Das Bild bleibt unverändert, der Schnitt kann aber um ein paar Frames abweichen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia il video ai fotogrammi chiave più vicini senza ricodificarlo. L'immagine resta intatta, ma il taglio può spostarsi di qualche fotogramma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corta o vídeo nos quadros-chave mais próximos sem recodificar. A imagem não é alterada, mas o corte pode ficar alguns quadros fora do lugar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knipt de video bij de dichtstbijzijnde keyframes, zonder opnieuw te coderen. Het beeld blijft onaangeroerd, maar de knip kan een paar frames verschoven zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tnie wideo przy najbliższych klatkach kluczowych bez ponownego kodowania. Obraz pozostaje nietknięty, ale cięcie może przesunąć się o kilka klatek."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обрезает видео по ближайшим ключевым кадрам без перекодирования. Изображение не меняется, но место обрезки может сместиться на несколько кадров."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoyu yeniden kodlamadan en yakın anahtar karelerden keser. Görüntüye dokunulmaz ancak kesim birkaç kare kayabilir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再エンコードせずに、最も近いキーフレームでビデオをカットします。映像は変わりませんが、カット位置が数フレームずれることがあります。"
          }
        }
      }
    },
