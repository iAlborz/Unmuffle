    "Instant mode saves next to the original. Allow Unmuffle to save in this folder?" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo instantáneo guarda junto al original. ¿Permitir que Unmuffle guarde en esta carpeta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode instantané enregistre à côté de l'original. Autoriser Unmuffle à enregistrer dans ce dossier ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sofort-Modus sichert neben dem Original. Darf Unmuffle in diesem Ordner sichern?"
          }
        },
        "it" : {
          "stringUnit" : {
