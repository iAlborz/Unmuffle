            "value" : "Wyeksportowane wideo nie będzie miało dźwięku."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортированное видео будет без звука."
          }
        },
        "tr" : {
          "stringUnit" : {
