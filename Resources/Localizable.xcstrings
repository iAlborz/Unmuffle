    "Quiets the moments that are much louder than the rest, so the whole recording sits at a steady level." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 부분보다 훨씬 큰 순간을 줄여 전체 녹음이 일정한 레벨을 유지하게 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压低比其他部分响亮得多的瞬间，让整段录音保持稳定的音量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓低比其他部分大聲許多的瞬間，讓整段錄音維持穩定的音量。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja los momentos mucho más fuertes que el resto para que toda la grabación quede a un nivel constante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atténue les moments bien plus forts que le reste, pour que tout l'enregistrement garde un niveau régulier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht Momente leiser, die viel lauter sind als der Rest, damit die ganze Aufnahme einen gleichmäßigen Pegel hat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa i momenti molto più forti del resto, così l'intera registrazione resta a un livello costante."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixa os momentos muito mais altos que o resto, para que toda a gravação fique em um nível estável."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt momenten die veel harder zijn dan de rest zachter, zodat de hele opname op een gelijkmatig niveau blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścisza momenty dużo głośniejsze od reszty, aby całe nagranie miało równy poziom."
