    "Evens out loud moments and brings the whole recording to a standard loudness." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 소리를 고르게 다듬고 전체 녹음을 표준 음량에 맞춥니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "压低过响的片段，并将整段录音调整到标准响度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壓低過大聲的片段，並將整段錄音調整到標準響度。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza los momentos fuertes y lleva toda la grabación a un volumen estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atténue les moments forts et amène tout l'enregistrement à un volume standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht laute Momente aus und bringt die ganze Aufnahme auf eine Standardlautstärke."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smussa i momenti forti e porta l'intera registrazione a un volume standard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza os momentos altos e leva toda a gravação a um volume padrão."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempert harde momenten en brengt de hele opname op een standaardluidheid."
          }
        },
        "pl" : {
