        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@. 주황색 탭을 드래그하여 변경하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@。拖动橙色标记即可调整。"
