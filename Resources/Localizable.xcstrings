    "Measured from the quiet parts: noise floor %lld dB, voice %lld dB. Reducing by %lld dB." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Measured from the quiet parts: noise floor %1$lld dB, voice %2$lld dB. Reducing by %3$lld dB."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 부분에서 측정: 노이즈 레벨 %lld dB, 음성 %lld dB. %lld dB만큼 줄입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据安静片段测得：底噪 %lld dB，人声 %lld dB。降低 %lld dB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據安靜片段測得：底噪 %lld dB，人聲 %lld dB。降低 %lld dB。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medido en los silencios: nivel de ruido %lld dB, voz %lld dB. Reducción de %lld dB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesuré dans les silences : niveau de bruit %lld dB, voix %lld dB. Réduction de %lld dB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemessen an den leisen Stellen: Grundrauschen %lld dB, Stimme %lld dB. Reduziert um %lld dB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misurato nei silenzi: livello del rumore %lld dB, voce %lld dB. Riduzione di %lld dB."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medido nos silêncios: nível de ruído %lld dB, voz %lld dB. Reduzindo %lld dB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeten in de stille stukken: ruisniveau %lld dB, stem %lld dB. Verlaagt met %lld dB."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmierzono w cichych fragmentach: poziom szumu %lld dB, głos %lld dB. Redukcja o %lld dB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измерено по тихим местам: уровень шума %lld dB, голос %lld dB. Подавление на %lld dB."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz bölümlerden ölçüldü: gürültü tabanı %lld dB, konuşma %lld dB. %lld dB azaltılıyor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな部分から測定：ノイズフロア %lld dB、声 %lld dB。%lld dB低減します。"
          }
        }
      }
    },
    "Measures the background noise in the quiet parts of the timeline and removes that much. Re-measures when the quiet parts change." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타임라인의 조용한 부분에서 배경 소음을 측정하고 그만큼 제거합니다. 조용한 부분이 바뀌면 다시 측정합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测量时间线中安静片段的背景噪音并去除相应的量。安静片段变化时会重新测量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "測量時間列中安靜片段的背景噪音並移除相應的量。安靜片段改變時會重新測量。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide el ruido de fondo en los silencios de la línea de tiempo y elimina esa cantidad. Vuelve a medir cuando cambian los silencios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure le bruit de fond dans les silences de la timeline et en retire autant. Refait la mesure quand les silences changent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst die Hintergrundgeräusche in den leisen Stellen der Zeitleiste und entfernt genau so viel. Misst neu, wenn sich die leisen Stellen ändern."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura il rumore di fondo nei silenzi della timeline e ne rimuove altrettanto. Ripete la misurazione quando i silenzi cambiano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede o ruído de fundo nos silêncios da linha do tempo e remove essa quantidade. Mede de novo quando os silêncios mudam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet het achtergrondgeluid in de stille stukken van de tijdlijn en verwijdert precies zoveel. Meet opnieuw als de stille stukken veranderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierzy szum tła w cichych fragmentach osi czasu i usuwa dokładnie tyle. Mierzy ponownie, gdy ciche fragmenty się zmienią."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измеряет фоновый шум в тихих местах временной шкалы и убирает его на эту величину. Если тихие места меняются, измеряет заново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaman çizelgesinin sessiz bölümlerindeki arka plan gürültüsünü ölçer ve o kadarını kaldırır. Sessiz bölümler değiştiğinde yeniden ölçer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインの静かな部分で背景ノイズを測定し、その分を除去します。静かな部分が変わると測定し直します。"
          }
        }
      }
    },
