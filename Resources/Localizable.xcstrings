    "Removes much more noise and mutes the gaps between words. Can make the voice sound thinner." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노이즈를 훨씬 더 많이 제거하고 단어 사이의 간격을 음소거합니다. 음성이 가늘게 들릴 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去除更多噪音，并将词与词之间的间隙静音。人声可能会变得单薄。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除更多噪音，並將字詞之間的空隙靜音。人聲可能會變得單薄。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina mucho más ruido y silencia los huecos entre palabras. Puede hacer que la voz suene más fina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire beaucoup plus de bruit et coupe le son entre les mots. Peut rendre la voix plus fine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt deutlich mehr Rauschen und schaltet die Pausen zwischen Wörtern stumm. Die Stimme kann dadurch dünner klingen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove molto più rumore e silenzia le pause tra le parole. Può rendere la voce più sottile."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove muito mais ruído e silencia os intervalos entre palavras. Pode deixar a voz mais fina."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert veel meer ruis en dempt de pauzes tussen woorden. De stem kan dunner gaan klinken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa znacznie więcej szumu i wycisza przerwy między słowami. Głos może brzmieć cieniej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает гораздо больше шума и глушит паузы между словами. Голос может стать тоньше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok daha fazla gürültü kaldırır ve sözcükler arasındaki boşlukları sessize alır. Konuşmayı daha ince duyurabilir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より多くのノイズを除去し、言葉と言葉の間を消音します。声が細くなることがあります。"
          }
        }
      }
    },
    "Replaces the sound with silence. The video is kept exactly as it is." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리를 무음으로 바꿉니다. 비디오는 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将声音替换为静音。视频保持原样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將聲音替換為靜音。影片保持原樣。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye el sonido por silencio. El vídeo se mantiene tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace le son par du silence. La vidéo est conservée telle quelle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt den Ton durch Stille. Das Video bleibt genau, wie es ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce il suono con il silenzio. Il video resta esattamente com'è."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o som por silêncio. O vídeo é mantido exatamente como está."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervangt het geluid door stilte. De video blijft precies zoals hij is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastępuje dźwięk ciszą. Wideo pozostaje dokładnie takie, jakie jest."
          }
