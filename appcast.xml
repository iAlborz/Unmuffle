    <item>
      <title>Unmuffle 1.4</title>
      <pubDate>Wed, 28 Oct 2026 16:58:37 +0000</pubDate>
      <sparkle:version>5</sparkle:version>
      <sparkle:shortVersionString>1.4</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <sparkle:fullReleaseNotesLink>https://github.com/iAlborz/Unmuffle/releases</sparkle:fullReleaseNotesLink>
      <description><![CDATA[<ul><li><b>Instant mode.</b> Drop videos and Unmuffle cleans them up right away, saving each one next to the original as `name-1`. No player, no Export button, nothing to confirm. Drop as many as you like; they're done one after another.</li><li>The Audio, Voice and Background Noise choices sit small on the right and apply to every video you drop.</li><li>Instant is the first of the three modes at the top of the window.</li></ul>]]></description>
      <enclosure url="https://github.com/iAlborz/Unmuffle/releases/download/v1.4/Unmuffle.zip" type="application/octet-stream" sparkle:edSignature="nKXWTeuY+YmKHjSn18dLrKIgCK8COUvX4ZCXqc8dQodT7A9UeBsCyyzFWaLL8MaVsXvoLPeH7kzPOMq7BvevAg==" length="22939111"/>
    </item>
    <item>
      <title>Unmuffle 1.3</title>
      <pubDate>Wed, 28 Oct 2026 03:22:45 +0000</pubDate>
      <sparkle:version>4</sparkle:version>
      <sparkle:shortVersionString>1.3</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <sparkle:fullReleaseNotesLink>https://github.com/iAlborz/Unmuffle/releases</sparkle:fullReleaseNotesLink>
      <description><![CDATA[<ul><li><b>Unmuffle now updates itself.</b> When a new version is out, a small banner appears at the top of the window, plus a notification if Unmuffle is in the background. Click <b>Update</b> and it downloads, installs and relaunches on its own.</li><li><b>Check for Updates…</b> in the Unmuffle menu, whenever you want to look yourself.</li><li>Updates are signed, and Unmuffle only installs ones signed by us.</li></ul>]]></description>
      <enclosure url="https://github.com/iAlborz/Unmuffle/releases/download/v1.3/Unmuffle.zip" type="application/octet-stream" sparkle:edSignature="etxROs/gBZzc3u46Z8awlF7OxUXApfpDakWSUTYTejzlHXgJ7qibSn0hqZlTIEOZLfFUR3ppry4Gszf6Zt48Bw==" length="22804236"/>
